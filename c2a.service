[Unit]
Description=c2a Codex subscription relay
Requires=c2a.socket
After=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/c2a serve
TimeoutStopSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/root/.local/state/c2a
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
